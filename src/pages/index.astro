/* =========================================================
   RESTAURAR MODO PRESENTACIÓN
   Conserva la versión anterior: una pantalla a la vez,
   transiciones laterales, swipe, modal y navegación flotante.
   ========================================================= */
html,body{
  height:100%;
  overflow:hidden;
  scroll-behavior:auto;
}
body{
  touch-action:pan-y;
  user-select:none;
}
.app{
  position:fixed;
  inset:0;
  min-height:0;
  overflow:hidden;
}
.deck{
  width:100%;
  height:100%;
  position:relative;
}
.slide{
  position:absolute;
  inset:0;
  min-height:0;
  height:auto;
  justify-content:center;
  padding:
    calc(env(safe-area-inset-top) + 24px)
    18px
    calc(env(safe-area-inset-bottom) + 88px);
  opacity:0;
  visibility:hidden;
  transform:translateX(14%) scale(.985);
  transition:
    opacity .4s ease,
    transform .5s cubic-bezier(.2,.8,.2,1),
    visibility .5s;
  overflow:hidden;
  scroll-margin-top:0;
}
.slide.active{
  opacity:1;
  visibility:visible;
  transform:translateX(0) scale(1);
  z-index:2;
}
.slide.before{transform:translateX(-14%) scale(.985)}
.tap-zone{display:block}
.swipe-note{
  display:block;
  bottom:98px;
  font-size:11px;
}

