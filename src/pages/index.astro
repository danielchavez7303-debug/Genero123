    font-size:11px;
  }
  body.responsive-ui .stack{grid-template-columns:1fr;gap:9px}
  body.responsive-ui .mini{gap:10px;padding:11px 12px}
  body.responsive-ui .mini .icon{
    width:42px;
    height:42px;
    flex-basis:42px;
    font-size:22px;
  }
  body.responsive-ui .mini b{font-size:15px;line-height:1.12}
  body.responsive-ui .mini span{font-size:12.5px;line-height:1.28}
  body.responsive-ui .mini .tap-icon{top:7px;right:7px;width:22px;height:22px}
  body.responsive-ui .myth-grid{grid-template-columns:1fr;gap:9px}
  body.responsive-ui .myth{padding:12px}
  body.responsive-ui .tip-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}
  body.responsive-ui .tip{min-height:108px;padding:11px 7px}
  body.responsive-ui .tip .emoji{font-size:29px;margin-bottom:5px}
  body.responsive-ui .tip b{font-size:13px;line-height:1.15}
  body.responsive-ui .report{grid-template-columns:1fr;gap:7px}
  body.responsive-ui .report-line{padding:9px 10px;font-size:13px}
  body.responsive-ui .breathe-area{height:205px}
  body.responsive-ui .nav{height:54px;bottom:6px;border-radius:20px}
}

@media(max-width:699px) and (max-height:599px){
  body.responsive-ui .slide{
    justify-content:flex-start;
    padding-top:8px;
    padding-bottom:calc(env(safe-area-inset-bottom) + 72px);
  }
  body.responsive-ui .slide > .card{max-height:calc(100dvh - 84px);padding:14px 12px}
  body.responsive-ui h2{font-size:30px;margin-bottom:7px}
  body.responsive-ui p{font-size:14px;line-height:1.3;margin:6px 0}
  body.responsive-ui .interactive-hint{margin:5px 0 8px;padding:6px 9px}
  body.responsive-ui .stack{gap:7px}
  body.responsive-ui .mini{padding:9px 10px}
  body.responsive-ui .mini .icon{width:38px;height:38px;flex-basis:38px;font-size:20px}
  body.responsive-ui .mini span{font-size:12px;line-height:1.22}
  body.responsive-ui .tip{min-height:92px}
  body.responsive-ui .breathe-area{height:170px}
  body.responsive-ui .nav{height:50px;bottom:5px}
  body.responsive-ui .nav button{height:36px}
}

@media(min-width:700px){
  body.responsive-ui{--nav-safe:96px}
  body.responsive-ui .stack{grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}
  body.responsive-ui .myth-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}
  body.responsive-ui .report{grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
  body.responsive-ui .tip-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}
  body.responsive-ui .tip.wide{grid-column:1/-1}
  body.responsive-ui .help-lab{
    display:grid;
    grid-template-columns:minmax(0,1.08fr) minmax(300px,.92fr);
    grid-template-areas:
      "kicker kicker"
      "title title"
      "intro intro"
      "options answer"
      "note note";
    column-gap:22px;
    align-items:start;
  }
  body.responsive-ui .help-lab > .kicker{grid-area:kicker}
  body.responsive-ui .help-lab > h2{grid-area:title}
  body.responsive-ui .help-lab > p.small{grid-area:intro}
  body.responsive-ui .help-lab > .help-grid{grid-area:options;margin-top:8px}
  body.responsive-ui .help-lab > .help-answer{grid-area:answer;margin-top:8px}
  body.responsive-ui .help-lab > .help-note{grid-area:note}

  /* El centro de ayuda usa su propia composición. No debe heredar la
     cuadrícula de dos columnas de la antigua respuesta interactiva. */
  body.responsive-ui .support-lab{
    display:block;
    max-width:980px!important;
  }
  body.responsive-ui .support-lab .support-grid{
    grid-template-columns:repeat(2,minmax(0,1fr));
  }
}

@media(min-width:1100px){
  body.responsive-ui .stack{grid-template-columns:repeat(3,minmax(0,1fr))}
  body.responsive-ui .myth-grid{grid-template-columns:repeat(3,minmax(0,1fr))}
  body.responsive-ui .report{grid-template-columns:repeat(3,minmax(0,1fr))}
  body.responsive-ui .tip-grid{grid-template-columns:repeat(3,minmax(0,1fr))}
  body.responsive-ui .tip.wide{grid-column:2}
}

@media(max-height:640px) and (min-width:700px){
  body.responsive-ui .slide{justify-content:flex-start;padding-top:14px}
  body.responsive-ui .slide > .card{max-height:calc(100dvh - 112px);padding:20px 24px}
  body.responsive-ui .breathe-area{height:205px}
}

/* =========================================================
   LABORATORIOS INTERACTIVOS
   ========================================================= */
.lab-heading{
  display:flex;
  align-items:flex-start;
  justify-content:space-between;
  gap:18px;
}
.lab-heading h2{margin-bottom:8px}
.lab-counter{
  flex:0 0 auto;
  padding:8px 11px;
  border-radius:999px;
  background:var(--lav);
  color:var(--purple);
  font-size:12px;
  font-weight:950;
}
.swipe-stage{
  position:relative;
  display:grid;
  place-items:center;
  min-height:322px;
  margin:12px auto 0;
  perspective:900px;
}
.myth-swipe-card{
  position:relative;
  width:min(100%,520px);
  min-height:270px;
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  padding:34px 30px 26px;
  text-align:center;
  border:1px solid rgba(255,255,255,.98);
  border-radius:30px;
  background:linear-gradient(145deg,#fff,#f7f4ff 58%,#effcf7);
  box-shadow:0 22px 55px rgba(23,22,79,.18);
  cursor:grab;
  touch-action:none;
  user-select:none;
  will-change:transform;
  transition:transform .34s cubic-bezier(.2,.8,.2,1),box-shadow .25s ease;
  z-index:2;
}
.myth-swipe-card.dragging{
  cursor:grabbing;
  transition:none;
  box-shadow:0 30px 70px rgba(23,22,79,.22);
}
.swipe-card-icon{
  width:58px;
  height:58px;
  display:grid;
  place-items:center;
  margin-bottom:11px;
  border-radius:19px;
  background:linear-gradient(145deg,var(--lav),var(--mint));
  font-size:30px;
}
.swipe-card-label{
  color:var(--purple);
  text-transform:uppercase;
  letter-spacing:.13em;
  font-size:10px;
  font-weight:950;
}
.myth-swipe-card h3{
  max-width:430px;
  margin:10px 0 20px;
  color:var(--navy);
  font-size:clamp(23px,3.2vw,34px);
  line-height:1.05;
}
.swipe-direction{
  width:100%;
  display:flex;
  justify-content:space-between;
  color:rgba(23,22,79,.43);
  font-size:11px;
  font-weight:950;
  letter-spacing:.06em;
}
.swipe-stamp{
  position:absolute;
  top:20px;
  padding:8px 11px;
  border:3px solid currentColor;
  border-radius:10px;
  font-size:16px;
  font-weight:1000;
  opacity:0;
  transition:opacity .12s ease;
}
.stamp-myth{left:20px;color:#c03b68;transform:rotate(-14deg)}
.stamp-reality{right:20px;color:var(--teal);transform:rotate(14deg)}
.myth-swipe-card.is-myth .stamp-myth{opacity:1}
.myth-swipe-card.is-reality .stamp-reality{opacity:1}
.swipe-feedback{
  position:absolute;
  left:50%;
  bottom:0;
  width:min(100%,520px);
  min-height:42px;
  transform:translateX(-50%) translateY(8px);
  color:var(--muted);
  text-align:center;
  font-size:13px;
  line-height:1.35;
  opacity:0;
  transition:opacity .25s ease,transform .25s ease;
}
.swipe-feedback.show{opacity:1;transform:translateX(-50%) translateY(0)}
.swipe-feedback strong{color:var(--teal)}
.swipe-progress{
  width:min(100%,520px);
  height:6px;
  margin:9px auto 0;
  overflow:hidden;
  border-radius:999px;
  background:rgba(23,22,79,.08);
}
.swipe-progress span{
  display:block;
  width:10%;
  height:100%;
  border-radius:inherit;
  background:linear-gradient(90deg,var(--purple),var(--teal));
  transition:width .35s ease;
}
.swipe-score{
  margin:7px 0 0;
  color:var(--muted);
  text-align:center;
  font-size:12px!important;
}

.fracture-lab{text-align:center}
.glass-wrap{
  position:relative;
  width:min(100%,560px);
  height:315px;
  margin:12px auto 10px;
  display:grid;
  place-items:center;
}
.glass-surface{
  position:relative;
  z-index:3;
  width:min(100%,420px);
  height:250px;
  display:grid;
  place-items:center;
  isolation:isolate;
}
.glass-message{
  position:absolute;
  z-index:1;
  display:grid;
  place-items:center;
  gap:9px;
  color:var(--navy);
  text-align:center;
  font-size:clamp(18px,2.5vw,27px);
  line-height:1.1;
  opacity:0;
  transform:scale(.82) translateY(14px);
  transition:opacity .4s ease,transform .55s cubic-bezier(.2,.8,.2,1);
}
.glass-message-icon{font-size:38px}
.glass-wrap.broken .glass-message{opacity:1;transform:scale(1) translateY(0)}
.glass-card{
  position:relative;
  z-index:3;
  width:100%;
  height:100%;
  overflow:hidden;
  display:grid;
  place-items:center;
  border:1px solid rgba(255,255,255,.9);
  border-radius:28px;
  background:
    radial-gradient(circle at 28% 22%,rgba(255,255,255,.72),transparent 25%),
    linear-gradient(135deg,rgba(255,255,255,.70),rgba(191,222,248,.34) 58%,rgba(255,255,255,.48));
  box-shadow:inset 0 0 0 1px rgba(255,255,255,.72),inset 0 0 38px rgba(255,255,255,.28),0 24px 50px rgba(23,22,79,.20);
  color:var(--navy);
  cursor:crosshair;
  transition:opacity .35s ease,transform .55s cubic-bezier(.2,.8,.2,1),filter .4s ease;
  will-change:transform,opacity,filter;
}
.glass-card::before,
.glass-card::after{
  content:"";
  position:absolute;
  inset:0;
  border-radius:inherit;
  pointer-events:none;
  z-index:0;
}
.glass-card::before{
  border:1px solid rgba(255,255,255,.66);
  box-shadow:inset 18px 18px 38px rgba(255,255,255,.24),inset -18px -18px 40px rgba(107,157,208,.10);
}
.glass-card::after{
  background:radial-gradient(circle at var(--impact-x,50%) var(--impact-y,50%),rgba(255,255,255,.92) 0 1.5%,rgba(255,255,255,.36) 2.5%,rgba(255,255,255,.08) 8%,transparent 22%);
  opacity:0;
}
.glass-card.impact{
  animation:glassTap .22s ease both;
}
.glass-card.impact::after{
  animation:impactFlash .5s ease-out both;
}
.glass-card.broken{opacity:0;transform:scale(1.13) rotate(3deg);filter:blur(2px);pointer-events:none;animation:glassBreak .36s cubic-bezier(.2,.76,.24,1) both}
.glass-shine{
  position:absolute;
  top:-40%;
  left:-30%;
  width:28%;
  height:180%;
  transform:rotate(18deg);
  background:linear-gradient(90deg,transparent,rgba(255,255,255,.65),transparent);
  animation:glassShine 4.5s ease-in-out infinite;
}
@keyframes glassShine{0%,35%{left:-35%}70%,100%{left:120%}}
.glass-word{position:relative;z-index:1;font-size:clamp(19px,3vw,31px);font-weight:1000;line-height:1.02}
.glass-hint{position:absolute;z-index:1;bottom:18px;color:rgba(23,22,79,.48);font-size:11px;font-weight:800}
.crack-svg{position:absolute;inset:0;z-index:5;width:100%;height:100%;pointer-events:none;overflow:visible;transition:opacity .45s ease}
:global(.crack-svg path){fill:none;stroke-linecap:round;stroke-linejoin:round;vector-effect:non-scaling-stroke;stroke-dasharray:1;stroke-dashoffset:1;animation:drawCrack .58s cubic-bezier(.22,.7,.2,1) var(--crack-delay,0ms) both}
:global(.crack-svg .crack-highlight){stroke:rgba(255,255,255,.78);stroke-width:4.8;filter:drop-shadow(0 1px 1px rgba(255,255,255,.72))}
:global(.crack-svg .crack-shadow){stroke:rgba(18,36,92,.94);stroke-width:2.05;filter:drop-shadow(0 1px 1px rgba(14,24,70,.46))}
:global(.crack-svg .crack-impact){fill:none;stroke:rgba(18,36,92,.65);stroke-width:1.25;transform-box:fill-box;transform-origin:center;animation:impactPulse .5s ease-out var(--crack-delay,0ms) both}
:global(.crack-svg .crack-impact-core){fill:rgba(23,36,92,.9);stroke:rgba(255,255,255,.95);stroke-width:.9;transform-box:fill-box;transform-origin:center;animation:impactCore .32s ease-out var(--crack-delay,0ms) both}
@keyframes drawCrack{to{stroke-dashoffset:0}}
@keyframes impactPulse{0%{opacity:0;transform:scale(.35)}35%{opacity:.9}100%{opacity:0;transform:scale(4.5)}}
@keyframes impactCore{0%{opacity:0;transform:scale(.2)}35%{opacity:1;transform:scale(1.15)}100%{opacity:.35;transform:scale(1)}}
@keyframes glassTap{0%,100%{transform:scale(1)}35%{transform:scale(.988)}70%{transform:scale(1.006)}}
@keyframes impactFlash{0%{opacity:0;transform:scale(.72)}28%{opacity:1}100%{opacity:0;transform:scale(1.18)}}
@keyframes glassBreak{0%{opacity:1;transform:scale(1);filter:none}18%{opacity:.96;transform:scale(1.012) rotate(-.5deg)}100%{opacity:0;transform:scale(1.1) rotate(1.5deg);filter:blur(5px)}}
:global(.glass-wrap.broken .crack-svg){opacity:.28}
.glass-shards{position:absolute;inset:0;z-index:6;pointer-events:none;overflow:visible}
:global(.glass-shard){position:absolute;left:var(--x);top:var(--y);width:var(--w);height:var(--h);background:linear-gradient(145deg,rgba(255,255,255,.98),rgba(126,179,226,.68) 56%,rgba(255,255,255,.22));filter:drop-shadow(0 2px 2px rgba(23,36,92,.22));opacity:0;transform:translate3d(-50%,-50%,0) scale(.35) rotate(0deg);animation:shardBurst var(--duration) cubic-bezier(.18,.76,.18,1) var(--delay) forwards}
@keyframes shardBurst{0%{opacity:0;transform:translate3d(-50%,-50%,0) scale(.35) rotate(0deg)}16%{opacity:.92;transform:translate3d(-50%,-50%,0) scale(1) rotate(calc(var(--rot) * .16))}100%{opacity:0;transform:translate3d(var(--tx),var(--ty),0) scale(.78) rotate(var(--rot))}}
.stereotype-options{display:flex;flex-wrap:wrap;justify-content:center;gap:8px}
.stereotype-option{
  padding:9px 12px;
  border:1px solid var(--line);
  border-radius:999px;
  background:#fff;
  color:var(--muted);
  font-size:11px;
  font-weight:850;
  cursor:pointer;
  transition:background .2s ease,color .2s ease,transform .2s ease;
}
.stereotype-option:hover,.stereotype-option.active{background:var(--navy);color:#fff;transform:translateY(-2px)}
.fracture-count{margin:9px 0 0!important;color:var(--muted);font-size:12px!important}

.duration-options{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:11px;margin:20px 0 14px}
.duration-option{
  min-height:118px;
  display:flex;
  flex-direction:column;
  align-items:flex-start;
  justify-content:center;
  gap:5px;
  padding:16px;
  border:1px solid var(--line);
  border-radius:20px;
  background:#fff;
  color:var(--navy);
  text-align:left;
  cursor:pointer;
  transition:transform .2s ease,background .2s ease,border-color .2s ease,box-shadow .2s ease;
}
.duration-option span{font-size:25px}
.duration-option b{font-size:15px}
.duration-option small{color:var(--muted);font-size:11px}
.duration-option:hover,.duration-option.selected{transform:translateY(-4px);border-color:rgba(130,104,218,.4);background:linear-gradient(145deg,#fff,#f2efff);box-shadow:0 12px 26px rgba(23,22,79,.10)}
.pause-plan{
  display:grid;
  grid-template-columns:56px minmax(0,1fr);
  gap:6px 14px;
  align-items:start;
  margin-top:14px;
  padding:18px;
  border:1px solid var(--line);
  border-radius:24px;
  background:linear-gradient(145deg,#f9f7ff,#f0fcf7);
  animation:rise .45s ease both;
}
.pause-plan-icon{width:56px;height:56px;display:grid;place-items:center;border-radius:18px;background:#fff;font-size:28px;box-shadow:0 8px 18px rgba(23,22,79,.08)}
.pause-plan-copy h3{margin:0;color:var(--navy);font-size:24px}
.pause-plan-copy p{margin:6px 0 0;font-size:14px}
.pause-steps{grid-column:1/-1;display:grid;gap:7px;margin-top:7px}
.pause-step{display:flex;align-items:flex-start;gap:8px;padding:9px 10px;border-radius:13px;background:rgba(255,255,255,.74);color:var(--muted);font-size:13px;line-height:1.35}
.pause-step::before{content:"✓";color:var(--teal);font-weight:950}
.pause-breath{grid-column:1/-1}
.pause-breath .breathe-area{height:190px}
.pause-actions{grid-column:1/-1;display:flex;gap:9px;align-items:center;margin-top:7px}
.pause-actions .action{flex:1}
.quiet-action{border:1px solid var(--line);border-radius:16px;padding:12px 14px;background:#fff;color:var(--navy);font-size:14px;font-weight:900;cursor:pointer;transition:transform .2s ease,background .2s ease}
.quiet-action:hover{transform:translateY(-2px);background:var(--lav)}

.wheel-layout{display:grid;grid-template-columns:1fr;gap:0;align-items:center;justify-content:center;margin:8px auto 2px;max-width:520px}
.wheel-layout.has-result{gap:22px}
.wheel-wrap{position:relative;width:min(100%,440px);aspect-ratio:1;margin:0 auto;display:grid;place-items:center}
.wheel-pointer{position:absolute;z-index:5;top:4px;left:50%;width:0;height:0;transform:translateX(-50%);border-left:12px solid transparent;border-right:12px solid transparent;border-top:20px solid #ef426f;filter:drop-shadow(0 3px 3px rgba(23,22,79,.22));pointer-events:none}
.care-wheel{display:block;width:100%;height:100%;overflow:visible;transform-origin:50% 50%;transition:transform 3.8s cubic-bezier(.12,.78,.18,1);will-change:transform;filter:drop-shadow(0 16px 20px rgba(23,22,79,.14))}
:global(.wheel-sector){stroke:#fff;stroke-width:3;stroke-linejoin:round}
.wheel-ring{fill:none;stroke:#fff;stroke-width:3}
:global(.wheel-label){font-family:Inter,system-ui,-apple-system,"Segoe UI",sans-serif;font-size:28px;font-weight:950;letter-spacing:-.025em;fill:#172b66;text-anchor:middle;dominant-baseline:middle;paint-order:stroke;stroke:rgba(255,255,255,.78);stroke-width:1.35px}
:global(.wheel-label.long){font-size:23px;letter-spacing:-.035em}
.wheel-center{position:absolute;z-index:3;left:50%;top:50%;width:74px;height:74px;transform:translate(-50%,-50%);border:5px solid #fff;border-radius:50%;background:#edf6fb;color:var(--navy);font-size:0;box-shadow:0 5px 12px rgba(23,22,79,.16);cursor:pointer}
.wheel-center::before{content:"▶";font-size:23px;line-height:1;margin-left:3px}
.wheel-result{padding:22px;border-radius:22px;background:linear-gradient(145deg,#fff8e8,#f5f0ff);border:1px solid rgba(23,22,79,.12);box-shadow:0 12px 28px rgba(23,22,79,.08)}
.wheel-result.refreshing{animation:resultSwap .5s cubic-bezier(.2,.8,.2,1) both}
.wheel-result-icon{font-size:38px;margin-bottom:10px}
.wheel-result h3{margin:0;color:var(--navy);font-size:27px}
.wheel-result p{margin:8px 0 0;font-size:15px}
.wheel-wrap.won{animation:wheelCelebrate .7s ease}
@keyframes wheelCelebrate{0%,100%{transform:scale(1)}45%{transform:scale(1.04) rotate(-1deg)}75%{transform:scale(1.02) rotate(1deg)}}
@keyframes resultSwap{0%{opacity:.35;transform:translateX(18px) scale(.97)}100%{opacity:1;transform:translateX(0) scale(1)}}
.wheel-lab > .quiet-action{display:block;margin:6px auto 0;background:var(--navy);border-color:var(--navy);color:#fff;box-shadow:0 10px 22px rgba(23,22,79,.18)}

@media(min-width:700px){
  .wheel-layout.has-result{grid-template-columns:minmax(280px,440px) minmax(0,1fr);max-width:820px;gap:28px}
}

.help-lab{max-width:980px!important}
.help-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin:18px 0 14px}
.help-option{display:grid;grid-template-columns:42px minmax(0,1fr);grid-template-rows:auto auto;gap:3px 10px;align-items:center;padding:13px;border:1px solid var(--line);border-radius:18px;background:#fff;color:var(--navy);text-align:left;cursor:pointer;transition:transform .2s ease,background .2s ease,box-shadow .2s ease}
.help-option:hover{transform:translateY(-3px);background:linear-gradient(145deg,#fff,#f3f0ff);box-shadow:0 10px 24px rgba(23,22,79,.10)}
.help-option span{grid-row:1/-1;width:42px;height:42px;display:grid;place-items:center;border-radius:14px;background:linear-gradient(145deg,var(--lav),var(--mint));font-size:22px}
.help-option b{font-size:14px;line-height:1.15}
.help-option small{color:var(--muted);font-size:11px}
.help-option-wide{grid-column:1/-1}
.help-answer{display:grid;grid-template-columns:58px minmax(0,1fr);grid-template-rows:auto minmax(0,1fr) auto;gap:8px 14px;height:260px;min-height:260px;margin-top:12px;padding:18px;border:1px solid rgba(8,125,116,.18);border-radius:22px;background:linear-gradient(145deg,#effcf7,#f7f3ff);overflow:visible;transition:box-shadow .25s ease,background .25s ease}
.help-answer.is-empty{background:linear-gradient(145deg,#f3fbfa,#f7f3ff);border-color:rgba(130,104,218,.16)}
.help-answer.refreshing{animation:helpAnswerSwap .45s cubic-bezier(.2,.8,.2,1) both}
.help-answer.is-empty .help-answer-icon{background:linear-gradient(145deg,var(--lav),var(--mint))}
.help-answer.is-empty .copy-phrase{visibility:hidden;pointer-events:none}
.help-answer[aria-hidden="true"] .help-phrase{opacity:.8}
