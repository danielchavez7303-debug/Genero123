<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#17164f">
<title>El autocuidado no tiene género — Presentación interactiva</title>

<style>
:root{
  --navy:#17164f;
  --navy2:#28256d;
  --purple:#8268da;
  --lav:#eee9ff;
  --mint:#def7ef;
  --teal:#087d74;
  --pink:#ffdeea;
  --rose:#da4779;
  --yellow:#fff2bf;
  --blue:#dff3ff;
  --cream:#fffdfa;
  --ink:#29263d;
  --muted:#716e83;
  --line:rgba(23,22,79,.12);
  --shadow:0 18px 50px rgba(23,22,79,.14);
}

*{
  box-sizing:border-box;
  -webkit-tap-highlight-color:transparent;
}

html,body{
  margin:0;
  width:100%;
  height:100%;
  overflow:hidden;
  font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif;
  background:#f7f6ff;
  color:var(--ink);
  overscroll-behavior:none;
}

body{
  touch-action:pan-y;
  user-select:none;
}

.app{
  position:fixed;
  inset:0;
  overflow:hidden;
  background:
    radial-gradient(circle at 10% 10%,rgba(190,177,255,.34),transparent 26%),
    radial-gradient(circle at 90% 14%,rgba(166,241,223,.30),transparent 28%),
    radial-gradient(circle at 86% 88%,rgba(255,191,215,.27),transparent 28%),
    linear-gradient(160deg,#fffdfb,#f7f4ff 52%,#f4fffb);
}

.progress-track{
  position:fixed;
  top:0;
  left:0;
  right:0;
  height:4px;
  z-index:50;
  background:rgba(23,22,79,.08);
}
.progress-bar{
  height:100%;
  width:10%;
  background:linear-gradient(90deg,var(--purple),var(--teal));
  transition:width .35s ease;
}

.deck{
  width:100%;
  height:100%;
  position:relative;
}

.slide{
  position:absolute;
  inset:0;
  display:flex;
  flex-direction:column;
  justify-content:center;
  padding:
    calc(env(safe-area-inset-top) + 24px)
    18px
    calc(env(safe-area-inset-bottom) + 88px);
  opacity:0;
  visibility:hidden;
  transform:translateX(14%) scale(.985);
  transition:
    opacity .4s ease,
    transform .5s cubic-bezier(.2,.8,.2,1),
    visibility .5s;
  overflow:hidden;
}

.slide.active{
  opacity:1;
  visibility:visible;
  transform:translateX(0) scale(1);
  z-index:2;
}

.slide.before{
  transform:translateX(-14%) scale(.985);
}

.slide.active .reveal{
  animation:rise .55s cubic-bezier(.2,.8,.2,1) both;
}
.slide.active .d1{animation-delay:.06s}
.slide.active .d2{animation-delay:.12s}
.slide.active .d3{animation-delay:.18s}
.slide.active .d4{animation-delay:.24s}

@keyframes rise{
  from{opacity:0;transform:translateY(20px) scale(.98)}
  to{opacity:1;transform:translateY(0) scale(1)}
}
@keyframes floaty{
  0%,100%{transform:translateY(0) rotate(0)}
  50%{transform:translateY(-12px) rotate(4deg)}
}
@keyframes breathe{
  0%,100%{transform:scale(.72)}
  50%{transform:scale(1.12)}
}
@keyframes shimmer{
  to{background-position:200% center}
}
@keyframes tapPop{
  0%{transform:scale(1)}
  45%{transform:scale(.95)}
  100%{transform:scale(1)}
}
@keyframes modalIn{
  from{opacity:0;transform:translateY(26px) scale(.97)}
  to{opacity:1;transform:translateY(0) scale(1)}
}
@keyframes backdropIn{
  from{opacity:0}
  to{opacity:1}
}
@keyframes iconBounce{
  0%{transform:scale(.7) rotate(-8deg)}
  65%{transform:scale(1.08) rotate(4deg)}
  100%{transform:scale(1) rotate(0)}
}
@keyframes shine{
  0%{left:-120%}
  100%{left:140%}
}

.blob{
  position:absolute;
  width:190px;
  height:190px;
  border-radius:44% 56% 60% 40%;
  opacity:.5;
  z-index:-1;
  animation:floaty 8s ease-in-out infinite;
}
.b1{left:-80px;top:5%;background:#cfc2ff}
.b2{right:-80px;top:12%;background:#c7f1e6;animation-delay:-2s}
.b3{right:-90px;bottom:6%;background:#ffd5e4;animation-delay:-4s}
.b4{left:-85px;bottom:3%;background:#d2ecff;animation-delay:-6s}

.card{
  width:100%;
  max-width:520px;
  margin:0 auto;
  padding:24px 20px;
  border-radius:28px;
  background:rgba(255,255,255,.90);
  border:1px solid rgba(255,255,255,.95);
  outline:1px solid var(--line);
  box-shadow:var(--shadow);
  backdrop-filter:blur(12px);
}

.hero{
  text-align:center;
  padding:30px 20px;
}
.intro-action{max-width:310px;margin:20px auto 0}

.eyebrow{
  display:inline-flex;
  align-items:center;
  gap:7px;
  padding:9px 14px;
  border-radius:999px;
  background:linear-gradient(90deg,#eee9ff,#e5fbf4);
  color:var(--purple);
  font-size:13px;
  font-weight:900;
}

h1{
  margin:18px 0 0;
  color:var(--navy);
  font-size:clamp(42px,12vw,64px);
  line-height:.92;
  letter-spacing:-.045em;
  font-weight:950;
  text-transform:uppercase;
}
h1 span{
  background:linear-gradient(90deg,var(--navy),var(--purple),var(--teal),var(--navy));
  background-size:200% auto;
  -webkit-background-clip:text;
  background-clip:text;
  color:transparent;
  animation:shimmer 7s linear infinite;
}

h2{
  margin:0 0 14px;
  color:var(--navy);
  font-size:clamp(33px,9vw,48px);
  line-height:.98;
  letter-spacing:-.03em;
}

h3{
  margin:0 0 8px;
  color:var(--teal);
  font-size:22px;
}

p{
  margin:12px 0;
  font-size:18px;
  line-height:1.48;
}

.small{font-size:15px;color:var(--muted)}
.kicker{
  color:var(--purple);
  text-transform:uppercase;
  letter-spacing:.12em;
  font-size:12px;
  font-weight:950;
  margin-bottom:10px;
}

.slogan{
  margin-top:22px;
  padding:14px 16px;
  border-radius:20px;
  background:linear-gradient(90deg,var(--pink),var(--lav));
  color:var(--navy);
  font-weight:950;
  font-size:23px;
  line-height:1.15;
}

.interactive-hint{
  display:inline-flex;
  align-items:center;
  gap:7px;
  margin:8px 0 14px;
  padding:8px 11px;
  border-radius:999px;
  background:rgba(130,104,218,.10);
  color:var(--purple);
  font-size:12px;
  font-weight:850;
}

.stack{
  display:grid;
  gap:12px;
}

/* INTERACTIVE CARDS */
.interactive{
  cursor:pointer;
  position:relative;
  overflow:hidden;
  transition:
    transform .2s ease,
    box-shadow .2s ease,
    border-color .2s ease,
    background .2s ease;
}

.interactive::after{
  content:"";
  position:absolute;
  top:-20%;
  left:-120%;
  width:65%;
  height:140%;
  transform:rotate(18deg);
  background:linear-gradient(90deg,transparent,rgba(255,255,255,.62),transparent);
  pointer-events:none;
}

.interactive:active{
  animation:tapPop .24s ease;
  box-shadow:0 5px 14px rgba(23,22,79,.10);
}

.interactive:active::after{
  animation:shine .45s ease;
}

.interactive .tap-icon{
  position:absolute;
  right:9px;
  top:9px;
  width:24px;
  height:24px;
  border-radius:50%;
  display:grid;
  place-items:center;
  background:rgba(130,104,218,.10);
  color:var(--purple);
  font-size:12px;
  font-weight:950;
}

.mini{
  display:flex;
  gap:13px;
  align-items:flex-start;
  padding:15px;
  border-radius:20px;
  background:#fff;
  border:1px solid var(--line);
  box-shadow:0 8px 22px rgba(23,22,79,.06);
}
.mini .icon{
  width:50px;
  height:50px;
  flex:0 0 50px;
  display:grid;
  place-items:center;
  border-radius:16px;
  background:linear-gradient(145deg,var(--lav),var(--mint));
  font-size:27px;
}
.mini b{
  display:block;
  color:var(--navy);
  margin-bottom:2px;
  font-size:17px;
  padding-right:22px;
}
.mini span{
  color:var(--muted);
  font-size:14px;
  line-height:1.35;
}

.callout{
  text-align:center;
  background:linear-gradient(145deg,#fff8d8,#fff0f6);
  border:2px dashed #e6b34c;
}
.callout .big{
  font-size:31px;
  line-height:1.08;
  font-weight:950;
  color:var(--navy);
  margin:4px 0 12px;
}

.myth{
  padding:15px;
  border-radius:20px;
  background:#fff;
  border:1px solid var(--line);
}
.myth + .myth{margin-top:10px}
.myth-head{
  display:flex;
  gap:10px;
  align-items:center;
  font-weight:950;
  color:var(--navy);
  padding-right:24px;
}
.bad,.good{
  width:34px;
  height:34px;
  flex:0 0 34px;
  border-radius:11px;
  display:grid;
  place-items:center;
  font-weight:950;
}
.bad{background:#ffe3eb;color:#b93663}
.good{background:#def7ef;color:#087d74}

.tip-grid{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:11px;
}
.tip{
  min-height:132px;
  padding:14px 10px;
  text-align:center;
  display:flex;
  flex-direction:column;
  justify-content:center;
  align-items:center;
  border-radius:20px;
  background:#fff;
  border:1px solid var(--line);
  box-shadow:0 8px 22px rgba(23,22,79,.06);
}
.tip.wide{grid-column:1/-1;min-height:112px}
.tip .emoji{font-size:34px;margin-bottom:8px}
.tip b{font-size:15px;line-height:1.18;color:var(--navy);padding:0 12px}

.breathe-card{
  text-align:center;
}
.breathe-area{
  position:relative;
  height:285px;
  display:grid;
  place-items:center;
}
.breathe-circle{
  width:155px;
  height:155px;
  border-radius:50%;
  background:radial-gradient(circle at 35% 30%,#fff,#d8cdff 55%,#9578e3);
  box-shadow:0 20px 55px rgba(124,98,211,.28);
}
.breathe-circle.run{animation:breathe 8s ease-in-out infinite}
.breathe-label{
  position:absolute;
  bottom:15px;
  left:50%;
  transform:translateX(-50%);
  white-space:nowrap;
  padding:9px 14px;
  border-radius:999px;
  background:#fff;
  border:1px solid var(--line);
  color:var(--navy);
  font-size:14px;
  font-weight:900;
}
.action{
  width:100%;
  border:0;
  border-radius:18px;
  padding:14px 16px;
  background:linear-gradient(90deg,var(--navy),var(--purple));
  color:white;
  font-size:16px;
  font-weight:950;
  box-shadow:0 12px 28px rgba(23,22,79,.20);
  cursor:pointer;
  transition:transform .2s ease,box-shadow .2s ease,filter .2s ease;
}
.action:hover{filter:brightness(1.06);transform:translateY(-2px);box-shadow:0 16px 32px rgba(23,22,79,.24)}
.action:active{transform:translateY(0) scale(.985)}

.report{
  display:grid;
  gap:8px;
}
.report-line{
  padding:11px 12px;
  border-radius:14px;
  background:#fff;
  border-left:5px solid var(--purple);
  font-size:14px;
  line-height:1.32;
  box-shadow:0 5px 14px rgba(23,22,79,.05);
}

.myth-grid{
  display:grid;
  gap:10px;
}
.myth-grid .myth + .myth{margin-top:0}

.nav{
  position:fixed;
  z-index:60;
  left:12px;
  right:12px;
  bottom:calc(env(safe-area-inset-bottom) + 10px);
  height:62px;
  display:grid;
  grid-template-columns:60px 1fr 60px;
  gap:10px;
  align-items:center;
  padding:8px;
  border-radius:24px;
  background:rgba(255,255,255,.84);
  border:1px solid rgba(255,255,255,.95);
  outline:1px solid var(--line);
  box-shadow:0 16px 45px rgba(23,22,79,.18);
  backdrop-filter:blur(15px);
}

.nav button{
  height:46px;
  border:0;
  border-radius:16px;
  color:white;
  background:var(--navy);
  font-size:22px;
  font-weight:950;
  cursor:pointer;
  transition:transform .2s ease,opacity .2s ease,background .2s ease;
}
.nav button:hover:not(:disabled){transform:translateY(-2px);background:var(--navy2)}
.nav button:active:not(:disabled){transform:scale(.96)}
.nav button:disabled{opacity:.35;cursor:default}
.nav-center{
  text-align:center;
  color:var(--navy);
}
.nav-center b{
  display:block;
  font-size:13px;
}
.nav-center span{
  display:block;
  font-size:11px;
  color:var(--muted);
  margin-top:2px;
}

.tap-zone{
  position:fixed;
  top:0;
  bottom:84px;
  width:9%;
  z-index:20;
}
.tap-zone.left{left:0}
.tap-zone.right{right:0}

.swipe-note{
  position:absolute;
  bottom:98px;
  left:0;
  right:0;
  text-align:center;
  color:rgba(23,22,79,.45);
  font-size:11px;
  pointer-events:none;
}
.desktop-hint{display:none}

button:focus-visible,
.interactive:focus-visible{
  outline:3px solid rgba(8,125,116,.55);
  outline-offset:3px;
}

/* MODAL / BOTTOM SHEET */
.modal-backdrop{
  position:fixed;
  inset:0;
  z-index:150;
  background:rgba(14,13,45,.42);
  backdrop-filter:blur(8px);
  opacity:0;
  visibility:hidden;
  transition:opacity .25s ease, visibility .25s ease;
}

.modal-backdrop.open{
  opacity:1;
  visibility:visible;
  animation:backdropIn .25s ease both;
}

.modal-sheet{
  position:absolute;
  left:10px;
  right:10px;
  bottom:calc(env(safe-area-inset-bottom) + 10px);
  max-height:min(78vh,650px);
  overflow:auto;
  background:rgba(255,255,255,.98);
  border-radius:30px;
  padding:12px 18px 20px;
  box-shadow:0 28px 90px rgba(13,12,45,.35);
  border:1px solid rgba(255,255,255,.95);
  transform:translateY(35px) scale(.97);
}

.modal-backdrop.open .modal-sheet{
  animation:modalIn .38s cubic-bezier(.2,.8,.2,1) both;
}

.modal-sheet.dragging{
  animation:none !important;
  transition:none !important;
  will-change:transform;
}
.modal-backdrop.dragging{
  transition:none !important;
}


.modal-handle{
  width:100%;
  height:34px;
  margin:-4px 0 3px;
  position:relative;
  background:transparent;
  touch-action:none;
  cursor:grab;
}
.modal-handle::after{
  content:"";
  position:absolute;
  left:50%;
  top:10px;
  width:52px;
  height:6px;
  transform:translateX(-50%);
  border-radius:999px;
  background:rgba(23,22,79,.16);
  transition:width .15s ease, background .15s ease;
}
.modal-sheet.dragging .modal-handle::after{
  width:66px;
  background:rgba(130,104,218,.38);
}
.modal-sheet.dragging .modal-handle{
  cursor:grabbing;
}

.modal-top{
  display:grid;
  grid-template-columns:62px 1fr 38px;
  gap:12px;
  align-items:center;
}

.modal-icon{
  width:62px;
  height:62px;
  border-radius:20px;
  display:grid;
  place-items:center;
  font-size:34px;
  background:linear-gradient(145deg,var(--lav),var(--mint));
  animation:iconBounce .45s cubic-bezier(.2,.8,.2,1) both;
}

.modal-title{
  margin:0;
  font-size:24px;
  line-height:1.05;
  color:var(--navy);
  font-weight:950;
}

.modal-close{
  width:38px;
  height:38px;
  border:0;
  border-radius:14px;
  background:#f1eff8;
  color:var(--navy);
  font-size:19px;
  font-weight:900;
}

.modal-body{
  margin-top:16px;
}

.modal-body p{
  font-size:16px;
  line-height:1.5;
  margin:10px 0;
}

.modal-info{
  margin-top:14px;
  padding:14px;
  border-radius:18px;
  background:linear-gradient(145deg,#f6f2ff,#effcf7);
  border:1px solid var(--line);
}

.modal-info strong{
  display:block;
  color:var(--teal);
  margin-bottom:5px;
}

.modal-example{
  margin-top:12px;
  padding:13px 14px;
  border-radius:18px;
  background:#fff8d9;
  border:1px solid rgba(230,179,76,.35);
}

.modal-example strong{
  color:#986d14;
}

.modal-action{
  margin-top:16px;
  width:100%;
  border:0;
  border-radius:17px;
  padding:13px 15px;
  background:linear-gradient(90deg,var(--navy),var(--purple));
  color:#fff;
  font-size:15px;
  font-weight:950;
}

.dots{
  display:flex;
  justify-content:center;
  gap:5px;
  margin-top:14px;
}
.dot{
  width:6px;
  height:6px;
  border-radius:50%;
  background:rgba(23,22,79,.16);
}
.dot.on{background:var(--purple);transform:scale(1.35)}

/* =========================================================
   ESCRITORIO / TABLET
   La presentación mantiene el formato por diapositivas, pero
   aprovecha el espacio horizontal cuando hay más pantalla.
   ========================================================= */
@media(min-width:700px){
  html,body{overflow:hidden}

  .app{
    padding:0 clamp(18px,3vw,54px);
  }

  .deck{
    max-width:1280px;
    margin:0 auto;
  }

  .slide{
    justify-content:center;
    padding:
      clamp(48px,8vh,94px)
      clamp(12px,2vw,34px)
      calc(env(safe-area-inset-bottom) + 104px);
    overflow-y:auto;
    scrollbar-width:none;
  }
  .slide::-webkit-scrollbar{display:none}

  .card{
    width:100%;
    max-width:980px;
    padding:clamp(28px,3.3vw,48px);
    border-radius:36px;
  }

  .hero{padding:clamp(38px,5vw,70px)}
  h1{font-size:clamp(58px,7.4vw,106px)}
  h2{font-size:clamp(40px,4.8vw,68px)}
  p{font-size:19px}
  .stack{grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}

  .nav{
    left:50%;
    right:auto;
    width:min(720px,calc(100% - 48px));
    transform:translateX(-50%);
  }

  .tap-zone{width:48px}
  .swipe-note{font-size:12px}
  .mobile-hint{display:none}
  .desktop-hint{display:inline}

  .modal-sheet{
    max-width:680px;
    left:50%;
    right:auto;
    width:calc(100% - 48px);
    transform:translateX(-50%) translateY(35px) scale(.97);
  }
  .modal-backdrop.open .modal-sheet{
    animation:none;
    transform:translateX(-50%) translateY(0) scale(1);
    transition:.35s ease;
  }

  .tip-grid{grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}
  .tip.wide{grid-column:2;min-height:132px}

  .myth-grid{grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}
  .myth-grid .myth{min-height:184px}
  .wide-card{max-width:1120px}
  .wide-card .report{grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}
  .wide-card .report-line{min-height:92px;display:flex;align-items:center}
}

@media(min-width:980px){
  .card{max-width:1120px}
  .stack{grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}
  .mini{min-height:190px;padding:20px;flex-direction:column}
  .mini .icon{width:58px;height:58px;flex-basis:58px;margin-bottom:4px}
  .mini b{font-size:18px}
  .mini span{font-size:15px}

  .breathe-card{
    max-width:980px;
    display:grid;
    grid-template-columns:minmax(0,1fr) minmax(300px,.82fr);
    grid-template-areas:
      "kicker visual"
      "title visual"
      "copy visual"
      "action visual";
    column-gap:clamp(28px,5vw,76px);
    align-items:center;
    text-align:left;
  }
  .breathe-card .kicker{grid-area:kicker}
  .breathe-card h2{grid-area:title}
  .breathe-card > p{grid-area:copy}
  .breathe-card .action{grid-area:action}
  .breathe-card .breathe-area{grid-area:visual;height:330px}
}

@media(max-width:699px) and (max-height:720px){
  .slide{
    justify-content:flex-start;
    padding-top:calc(env(safe-area-inset-top) + 20px);
    overflow-y:auto;
    scrollbar-width:none;
  }
  .slide::-webkit-scrollbar{display:none}
  .card{padding:22px 18px}
  .hero{padding:26px 18px}
  h1{font-size:clamp(38px,11vw,54px)}
  h2{font-size:clamp(30px,8.8vw,42px)}
  .slogan{font-size:20px}
  .breathe-area{height:220px}
}

@media(hover:hover){
  .interactive:hover{
    transform:translateY(-4px);
    box-shadow:0 14px 30px rgba(23,22,79,.12);
  }
