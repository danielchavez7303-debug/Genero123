body.web-experience.js-enabled .reveal{
  opacity:0;
  transform:translateY(18px);
}
body.web-experience.js-enabled .slide.active .reveal{animation:none}
body.web-experience.js-enabled .slide.in-view .reveal{
  animation:rise .68s cubic-bezier(.2,.8,.2,1) both;
}
body.web-experience.js-enabled .slide.in-view .d1{animation-delay:.08s}
body.web-experience.js-enabled .slide.in-view .d2{animation-delay:.16s}
body.web-experience.js-enabled .slide.in-view .d3{animation-delay:.24s}
body.web-experience.js-enabled .slide.in-view .d4{animation-delay:.32s}

body.web-experience .nav{
  top:16px;
  bottom:auto;
  left:50%;
  right:auto;
  width:min(570px,calc(100% - 420px));
  min-width:360px;
  height:54px;
