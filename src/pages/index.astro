/* Sin scroll: cada página se ajusta al espacio disponible. */
body.responsive-ui .slide{
  overflow:hidden;
}
body.responsive-ui .slide > .card{
  max-height:none;
  overflow:visible;
  transform:scale(var(--fit-scale,1));
  transform-origin:center center;
}
body.responsive-ui .slide.active > .card.reveal{
  opacity:1;
  animation:none;
  transform:scale(var(--fit-scale,1));
}

/* En ventanas bajas el panel parte desde arriba; así la escala no lo
   desplaza hacia fuera de la pantalla al calcular su tamaño. */
@media(max-height:640px){
  body.responsive-ui .slide > .card{
    transform-origin:center top;
  }
}

/* =========================================================
   SISTEMA DE ESCALA FINAL
   Las tarjetas conservan su composición y se reducen completas
   cuando el espacio vertical u horizontal no alcanza.
   ========================================================= */
body.responsive-ui .slide > .card{
  min-width:0;
  width:min(100%,1120px);
}
body.responsive-ui .slide > .card > *{
  min-width:0;
  max-width:100%;
}
body.responsive-ui .stack > *,
body.responsive-ui .tip-grid > *,
body.responsive-ui .myth-grid > *,
body.responsive-ui .report > *,
body.responsive-ui .duration-options > *,
body.responsive-ui .help-grid > *,
body.responsive-ui .wheel-layout > *{
  min-width:0;
}
body.responsive-ui h1,
body.responsive-ui h2,
body.responsive-ui h3,
body.responsive-ui p,
body.responsive-ui .small,
body.responsive-ui .slogan,
body.responsive-ui .eyebrow,
body.responsive-ui .kicker{
  max-width:100%;
