/* =========================================================
   EXPERIENCIA WEB
   Las pantallas se convierten en secciones desplazables:
   el contenido respira, se descubre al hacer scroll y la
   navegación funciona como apoyo, no como una diapositiva.
   ========================================================= */
html,
body{
  height:auto;
  min-height:100%;
  overflow-x:hidden;
  overflow-y:auto;
  scroll-behavior:smooth;
}

body.web-experience{
  touch-action:pan-y;
  user-select:auto;
}

body.web-experience .app{
  position:relative;
  inset:auto;
  min-height:100svh;
  overflow:visible;
}

body.web-experience .deck{
  height:auto;
  max-width:none;
}

body.web-experience .progress-track{
  height:3px;
  background:rgba(23,22,79,.10);
}

.site-header{
  position:fixed;
  z-index:75;
  top:17px;
  left:24px;
  display:flex;
  align-items:center;
  gap:12px;
  pointer-events:none;
}
.site-brand{
  pointer-events:auto;
  display:inline-flex;
  align-items:center;
  gap:9px;
  padding:8px 13px 8px 8px;
  border:1px solid rgba(255,255,255,.9);
  border-radius:18px;
  background:rgba(255,255,255,.76);
  color:var(--navy);
  box-shadow:0 10px 28px rgba(23,22,79,.10);
  backdrop-filter:blur(16px);
  cursor:pointer;
  transition:transform .2s ease,box-shadow .2s ease;
}
.site-brand:hover{transform:translateY(-2px);box-shadow:0 14px 32px rgba(23,22,79,.14)}
.brand-mark{
  width:32px;
  height:32px;
  display:grid;
  place-items:center;
  border-radius:11px;
  background:linear-gradient(145deg,var(--lav),var(--mint));
  font-size:17px;
}
.brand-copy{display:grid;text-align:left;line-height:1.05}
.brand-copy b{font-size:12px;letter-spacing:.02em}
.brand-copy small{margin-top:3px;color:var(--muted);font-size:10px}
.site-tag{
  color:rgba(23,22,79,.56);
  font-size:11px;
  font-weight:850;
  letter-spacing:.04em;
}

body.web-experience .slide{
  position:relative;
  inset:auto;
  min-height:100svh;
  height:auto;
  justify-content:center;
  padding:
    clamp(116px,15vh,164px)
    clamp(18px,7vw,112px)
    clamp(118px,14vh,150px);
  opacity:1;
  visibility:visible;
  transform:none;
  transition:none;
  overflow:visible;
  scroll-margin-top:92px;
}

body.web-experience .slide.active,
body.web-experience .slide.before{
  opacity:1;
  visibility:visible;
  transform:none;
  z-index:auto;
}

body.web-experience .slide:nth-child(2n){
  background:linear-gradient(180deg,rgba(255,255,255,.22),rgba(238,233,255,.17));
}
body.web-experience .slide:nth-child(3n){
  background:linear-gradient(180deg,rgba(222,247,239,.20),rgba(255,255,255,.06));
}
body.web-experience .slide > .blob{opacity:.34}
body.web-experience .tap-zone{display:none}

body.web-experience .swipe-note{
  display:flex;
  align-items:center;
  justify-content:center;
  gap:9px;
  bottom:34px;
  color:rgba(23,22,79,.52);
  font-size:12px;
  font-weight:800;
  letter-spacing:.02em;
}
.scroll-arrow{
  display:inline-grid;
  place-items:center;
  width:24px;
  height:24px;
  border:1px solid rgba(130,104,218,.28);
  border-radius:50%;
  animation:scrollCue 1.8s ease-in-out infinite;
}
@keyframes scrollCue{
  0%,100%{transform:translateY(0);opacity:.55}
  50%{transform:translateY(5px);opacity:1}
}

body.web-experience .slide:first-child .hero{
  position:relative;
  max-width:1120px;
  padding:clamp(30px,5vw,78px) 0;
  background:transparent;
  border:0;
  outline:0;
  box-shadow:none;
  backdrop-filter:none;
}
body.web-experience .slide:first-child .hero::before{
  content:"";
  position:absolute;
  z-index:0;
  right:-3%;
  top:7%;
  width:clamp(230px,30vw,420px);
  aspect-ratio:1;
  border-radius:42% 58% 63% 37%;
  background:linear-gradient(145deg,rgba(238,233,255,.88),rgba(222,247,239,.64) 54%,rgba(255,222,234,.72));
  filter:blur(.2px);
  transform:rotate(8deg);
  opacity:.78;
}
body.web-experience .slide:first-child .hero::after{
  content:"✦";
  position:absolute;
  z-index:0;
  right:13%;
  top:22%;
  width:clamp(120px,15vw,210px);
  aspect-ratio:1;
  display:grid;
  place-items:center;
  border:1px solid rgba(130,104,218,.24);
  border-radius:50%;
  color:rgba(130,104,218,.64);
  font-size:clamp(30px,4vw,58px);
  animation:floaty 7s ease-in-out infinite;
}
body.web-experience .slide:first-child .hero > *{position:relative;z-index:1}
