function resetGlass(){
  fractureHits = 0;
  glassBroken = false;
  const wrap = document.getElementById('glassWrap');
  const card = document.getElementById('glassCard');
  if(!wrap || !card) return;
  wrap.classList.remove('broken');
  card.classList.remove('broken');
  card.classList.remove('impact');
  card.style.visibility = 'visible';
  card.style.removeProperty('--impact-x');
  card.style.removeProperty('--impact-y');
  document.getElementById('crackSvg').innerHTML = '';
  document.getElementById('glassShards').innerHTML = '';
  document.getElementById('fractureCount').textContent = '0 / 4 toques';
}

function addCrack(x,y){
  const svg = document.getElementById('crackSvg');
  const ns = 'http://www.w3.org/2000/svg';
  const base = Math.random()*Math.PI*2;

  const impact = document.createElementNS(ns,'circle');
  impact.setAttribute('class','crack-impact');
  impact.setAttribute('cx',x); impact.setAttribute('cy',y); impact.setAttribute('r','3');
  svg.appendChild(impact);

  const core = document.createElementNS(ns,'circle');
  core.setAttribute('class','crack-impact-core');
  core.setAttribute('cx',x); core.setAttribute('cy',y); core.setAttribute('r','1.3');
  svg.appendChild(core);

  const makePath = (className,d,delay)=>{
    const path = document.createElementNS(ns,'path');
    path.setAttribute('class',className);
    path.setAttribute('pathLength','1');
    path.setAttribute('d',d);
    path.style.setProperty('--crack-delay',`${delay}ms`);
    svg.appendChild(path);
  };

  const clamp = value=>Math.max(3,Math.min(97,value));
  const crackPath = (x1,y1,angle,length,segments=3)=>{
    let d = `M ${x1.toFixed(2)} ${y1.toFixed(2)}`;
    let px = x1;
    let py = y1;
    for(let segment=1;segment<=segments;segment++){
      const progress = segment/segments;
      const wobble = (Math.random()-.5)*(segment===segments ? 3.2 : 5.2);
      px = clamp(x1 + Math.cos(angle)*length*progress + Math.cos(angle+Math.PI/2)*wobble);
      py = clamp(y1 + Math.sin(angle)*length*progress + Math.sin(angle+Math.PI/2)*wobble);
      d += ` L ${px.toFixed(2)} ${py.toFixed(2)}`;
    }
    return {d, x:px, y:py};
  };

  // Cinco fracturas principales, con una o dos ramificaciones: se siente
  // como vidrio que se abre desde el golpe, no como una estrella dibujada.
  for(let i=0;i<5;i++){
    const angle = base + i*(Math.PI*2/5) + (Math.random()-.5)*.22;
    const length = 28 + Math.random()*20;
    const main = crackPath(x,y,angle,length,3);
    const delay = i*34;
    makePath('crack-highlight',main.d,delay);
    makePath('crack-shadow',main.d,delay+18);

    if(i===1 || i===3){
      const branchStart = .44 + Math.random()*.20;
      const bx = x + Math.cos(angle)*length*branchStart;
      const by = y + Math.sin(angle)*length*branchStart;
      const branch = crackPath(bx,by,angle+(Math.random()>.5?1:-1)*(.65+Math.random()*.25),11+Math.random()*8,2);
      makePath('crack-highlight',branch.d,delay+50);
      makePath('crack-shadow',branch.d,delay+68);
    }
  }
}

function breakGlass(){
  glassBroken = true;
  const wrap = document.getElementById('glassWrap');
  const card = document.getElementById('glassCard');
  card.classList.add('broken');
  wrap.classList.add('broken');
  setTimeout(()=>{
    if(glassBroken) card.style.visibility = 'hidden';
  },390);
  const shards = document.getElementById('glassShards');
  const shardShapes = [
    'polygon(50% 0,100% 74%,28% 100%,0 38%)',
    'polygon(14% 0,100% 22%,74% 100%,0 70%)',
    'polygon(0 18%,68% 0,100% 78%,34% 100%)',
    'polygon(44% 0,100% 56%,62% 100%,0 72%)'
  ];
  for(let i=0;i<26;i++){
    const shard = document.createElement('span');
    shard.className = 'glass-shard';
    shard.style.setProperty('--x',`${45+Math.random()*10}%`);
    shard.style.setProperty('--y',`${36+Math.random()*28}%`);
    shard.style.setProperty('--w',`${9+Math.random()*25}px`);
    shard.style.setProperty('--h',`${11+Math.random()*32}px`);
    shard.style.clipPath = shardShapes[i%shardShapes.length];
    shard.style.setProperty('--tx',`${(Math.random()-.5)*340}px`);
    shard.style.setProperty('--ty',`${100+Math.random()*210}px`);
    shard.style.setProperty('--rot',`${(Math.random()-.5)*620}deg`);
    shard.style.setProperty('--duration',`${.7+Math.random()*.72}s`);
    shard.style.setProperty('--delay',`${Math.random()*.12}s`);
    shards.appendChild(shard);
  }
  document.getElementById('fractureCount').textContent = '✦ Idea rota';
  buzz(38);
}

function hitGlass(e){
  if(glassBroken) return;
  const card = document.getElementById('glassCard');
  const rect = card.getBoundingClientRect();
  const x = ((e.clientX || rect.left+rect.width/2)-rect.left)/rect.width*100;
  const y = ((e.clientY || rect.top+rect.height/2)-rect.top)/rect.height*100;
  card.style.setProperty('--impact-x',`${x}%`);
  card.style.setProperty('--impact-y',`${y}%`);
  card.classList.remove('impact');
  void card.offsetWidth;
  card.classList.add('impact');
  clearTimeout(card._impactTimer);
  card._impactTimer = setTimeout(()=>card.classList.remove('impact'),560);
  addCrack(x,y);
  fractureHits++;
  document.getElementById('fractureCount').textContent = `${fractureHits} / 4 toques`;
  buzz(7);
  if(fractureHits >= 4) setTimeout(breakGlass,180);
}

function choosePause(seconds){
  selectedPause = seconds;
  const plan = pausePlans[seconds];
  document.querySelectorAll('.duration-option').forEach(option=>option.classList.toggle('selected',Number(option.dataset.duration)===seconds));
  if(breathing) toggleBreathing();
  document.getElementById('pausePlan').hidden = false;
  document.getElementById('pausePlanIcon').textContent = plan.icon;
  document.getElementById('pausePlanKicker').textContent = `Tu pausa de ${seconds < 60 ? seconds+' segundos' : (seconds/60)+' minutos'}`;
  document.getElementById('pausePlanTitle').textContent = plan.title;
  document.getElementById('pausePlanText').textContent = plan.text;
  document.getElementById('pauseSteps').innerHTML = plan.steps.map(step=>`<div class="pause-step">${step}</div>`).join('');
  document.getElementById('pauseBreath').hidden = !plan.breath;
  const pauseAction = document.getElementById('pauseAction');
  pauseAction.classList.remove('is-running');
  pauseAction.textContent = plan.breath ? '▶ Empezar respiración' : '✓ Empezar pausa';
  requestAnimationFrame(fitSlides);
}

function startPause(){
  if(!selectedPause) return;
  const plan = pausePlans[selectedPause];
  if(plan.breath){
    toggleBreathing();
  }else{
    const action = document.getElementById('pauseAction');
    action.textContent = '✓ Pausa en marcha';
    action.classList.add('is-running');
    buzz(10);
  }
}

function anotherPause(){
  const options = [30,120,600].filter(value=>value!==selectedPause);
  choosePause(options[Math.floor(Math.random()*options.length)]);
}

function buildCareWheel(){
  const disc = document.getElementById('wheelDisc');
  if(!disc) return;

  const cx = 210;
  const cy = 210;
  const radius = 204;
  const colors = ['#ef8fb8','#ffcf68','#48c69d','#78d7eb','#7fa4e8','#9b7be0'];
  const centers = [0,60,120,180,240,300];
  const rotations = [90,-30,30,90,-30,30];
  const point = (angle,distance)=>{
    const radians = (angle-90)*Math.PI/180;
    return {x:cx+Math.cos(radians)*distance,y:cy+Math.sin(radians)*distance};
  };

  disc.innerHTML = careActivities.map((activity,index)=>{
    const centerAngle = centers[index];
    const start = point(centerAngle-30,radius);
    const end = point(centerAngle+30,radius);
    const labelText = activity.label || activity.title;
    const long = labelText.length > 8 ? ' long' : '';
    // Las frases largas necesitan quedar un poco más cerca del centro para
    // no cortarse en los sectores laterales, sobre todo en teléfonos.
    const label = point(centerAngle,long ? 111 : 130);
    return `<path class="wheel-sector" fill="${colors[index]}" d="M ${cx} ${cy} L ${start.x.toFixed(2)} ${start.y.toFixed(2)} A ${radius} ${radius} 0 0 1 ${end.x.toFixed(2)} ${end.y.toFixed(2)} Z"></path><text class="wheel-label${long}" x="${label.x.toFixed(2)}" y="${label.y.toFixed(2)}" transform="rotate(${rotations[index]} ${label.x.toFixed(2)} ${label.y.toFixed(2)})">${labelText}</text>`;
  }).join('');
}

function animateWheelSpin(wheel,startRotation,endRotation,duration=3900){
  cancelAnimationFrame(wheelAnimationFrame);
  wheel.style.transition='none';

  const startedAt = performance.now();
  const distance = endRotation-startRotation;
  let passedSections = 0;

  return new Promise(resolve=>{
    const frame = now=>{
      const progress = Math.min(1,(now-startedAt)/duration);
      // Aceleración rápida y desaceleración larga, como una rueda con peso.
      const eased = 1-Math.pow(1-progress,4);
      const currentRotation = startRotation+distance*eased;
      wheel.style.transform = `rotate(${currentRotation}deg)`;

      const sectionsPassed = Math.floor(Math.abs(currentRotation-startRotation)/60);
      if(sectionsPassed>passedSections){
        passedSections=sectionsPassed;
        buzz(5);
      }

      if(progress<1){
        wheelAnimationFrame=requestAnimationFrame(frame);
      }else{
        wheel.style.transform=`rotate(${endRotation}deg)`;
        wheel.style.transition='';
        resolve();
      }
    };
    wheelAnimationFrame=requestAnimationFrame(frame);
  });
}

function spinCare(){
  if(wheelSpinning) return;
  const wheel = document.getElementById('careWheel');
  const result = document.getElementById('wheelResult');
  const layout = document.querySelector('.wheel-layout');
  const spinAgain = document.getElementById('spinAgain');
  if(!wheel) return;
  const hasPreviousResult = !result.hidden;
  wheelSpinning = true;
  if(hasPreviousResult){
    // Conservamos la tarjeta mientras la rueda gira; solo cambia al llegar
    // el nuevo resultado.
    layout?.classList.add('has-result');
    if(spinAgain) spinAgain.hidden = false;
    result.classList.remove('refreshing');
  }else{
    result.hidden = true;
    layout?.classList.remove('has-result');
    if(spinAgain) spinAgain.hidden = true;
  }
  document.getElementById('wheelWrap').classList.remove('won');
  requestFit();
  const index = Math.floor(Math.random()*careActivities.length);
  // Cada etiqueta tiene un centro cada 60°. Calculamos el desplazamiento
  // desde la posición actual para que la opción bajo la flecha coincida
  // siempre con la tarjeta, también después de varios giros.
  const targetRotation = (360-(index*60))%360;
  const currentRotation = ((wheelRotation%360)+360)%360;
  const rotationDelta = (targetRotation-currentRotation+360)%360;
  const startRotation = wheelRotation;
  const endRotation = wheelRotation + 360*5 + rotationDelta;
  wheelRotation = endRotation;
  animateWheelSpin(wheel,startRotation,endRotation).then(()=>{
    const activity = careActivities[index];
    document.getElementById('wheelResultIcon').textContent = activity.icon;
    document.getElementById('wheelResultTitle').textContent = activity.title;
    document.getElementById('wheelResultText').textContent = activity.text;
    result.hidden = false;
    layout?.classList.add('has-result');
    if(spinAgain) spinAgain.hidden = false;
    result.classList.remove('refreshing');
    void result.offsetWidth;
    result.classList.add('refreshing');
    setTimeout(()=>result.classList.remove('refreshing'),520);
    document.getElementById('wheelWrap').classList.add('won');
    wheelSpinning = false;
    buzz(18);
    requestAnimationFrame(fitSlides);
  });
}

function fitSlides(){
  slides.forEach(slide=>{
    const card = [...slide.children].find(child=>child.classList?.contains('card'));
    if(!card) return;

    const slideStyle = getComputedStyle(slide);
    const paddingTop = parseFloat(slideStyle.paddingTop) || 0;
    const paddingBottom = parseFloat(slideStyle.paddingBottom) || 0;
    const contentAvailable = Math.max(96,slide.clientHeight-paddingTop-paddingBottom);
    // La navegación ya está contemplada en el padding inferior. Dejamos
    // además un pequeño colchón para que ningún borde quede debajo de ella.
    const viewportReserve = window.innerHeight < 700 ? 18 : 14;
    const available = Math.max(84,Math.min(contentAvailable-viewportReserve,window.innerHeight-paddingTop-paddingBottom-viewportReserve));

    // Medimos el contenido sin el límite heredado ni la transformación.
    // scrollHeight por sí solo puede quedarse corto cuando una tarjeta
    // cambió después de cargar; el rectángulo real cubre ambos casos.
    const previous = {
      transform:card.style.transform,
      maxHeight:card.style.maxHeight,
      height:card.style.height,
      overflow:card.style.overflow,
      animation:card.style.animation
    };
    card.style.setProperty('--fit-scale','1');
    card.style.transform='none';
    card.style.maxHeight='none';
    card.style.height='auto';
    card.style.overflow='visible';
    card.style.animation='none';

    const naturalBox = card.getBoundingClientRect();
    const naturalHeight = Math.max(card.scrollHeight,naturalBox.height,1);
    const scale = Math.min(1,available/naturalHeight);
    // El ancho ya está controlado por la tarjeta y sus cuadrículas. No usamos
    // scrollWidth aquí porque los adornos posicionados fuera de la tarjeta
    // podían hacer que toda la composición se encogiera falsamente.
    // En ventanas muy bajas se reduce la tarjeta completa antes que recortar
    // una fila, un botón o una ilustración.
    const safeScale = Math.max(.01,scale);
    card.style.setProperty('--fit-scale',safeScale.toFixed(3));
    card.style.transform = `scale(${safeScale.toFixed(3)})`;
    card.style.maxHeight='none';
    card.style.height=previous.height;
    card.style.overflow='visible';
    card.style.animation='none';
  });
}

let fitFrame = 0;
function requestFit(){
  cancelAnimationFrame(fitFrame);
  fitFrame = requestAnimationFrame(()=>{
    fitSlides();
    // Repetimos después del primer pintado para cubrir fuentes, cambios de
    // texto y paneles que aparecen con `hidden=false`.
    setTimeout(fitSlides,120);
  });
}

let current = 0;
let startX = 0;
let startY = 0;
let breathing = false;
let breathTimer = null;
let modalOpen = false;

// Estado del arrastre de la ventanita
let sheetDragging = false;
let sheetStartY = 0;
let sheetLastY = 0;
let sheetLastTime = 0;
let sheetVelocity = 0;
let sheetPointerId = null;
let sheetRAF = null;

function buzz(ms=12){
  if(navigator.vibrate) navigator.vibrate(ms);
}

function renderDots(){
  const holder = document.querySelector('[data-dots]');
  if(!holder) return;
  holder.innerHTML = slides.map((_,i)=>
    `<span class="dot ${i===current?'on':''}"></span>`
  ).join('');
}

function updateUI(){
  document.getElementById('counter').textContent = `${current+1} / ${slides.length}`;
  document.getElementById('sectionName').textContent = names[current] || '';
  document.getElementById('progress').style.width = `${((current+1)/slides.length)*100}%`;
  document.getElementById('prevButton').disabled = current === 0;
  document.getElementById('nextButton').disabled = current === slides.length - 1;
  renderDots();
}

function paintCurrentSlide(index, shouldBuzz=false){
  current = Math.max(0, Math.min(slides.length-1, index));

  slides.forEach((slide,i)=>{
    slide.classList.remove('active','before');
    if(i < current) slide.classList.add('before');
  });

  slides[current].classList.add('active','in-view');
  updateUI();
  requestFit();
  if(shouldBuzz) buzz();
}

function goToSlide(index){
  if(modalOpen) return;

  const target = Math.max(0, Math.min(slides.length-1, index));
  paintCurrentSlide(target,true);
}

function nextSlide(){
  if(current < slides.length-1) goToSlide(current+1);
}

function prevSlide(){
  if(current > 0) goToSlide(current-1);
}

function openInfo(key){
  const data = info[key];
  if(!data) return;

  modalOpen = true;
  buzz(18);

  document.getElementById('modalIcon').textContent = data.icon;
  document.getElementById('modalTitle').textContent = data.title;
  document.getElementById('modalText').textContent = data.text;

  const modal = document.getElementById('modal');
  const sheet = document.getElementById('modalSheet');

  // Cada vez que se abre empieza completamente en su sitio.
  sheet.classList.remove('dragging');
  sheet.style.animation = '';
  sheet.style.transition = '';
  sheet.style.transform = '';
  sheet.style.opacity = '';
  modal.style.opacity = '';
  modal.style.backgroundColor = '';

  modal.classList.add('open');
  document.body.style.overflow = 'hidden';
}

function closeInfo(dragged=false){
  const modal = document.getElementById('modal');
  const sheet = document.getElementById('modalSheet');

  modalOpen = false;
  sheetDragging = false;
  sheet.classList.remove('dragging');

  if(dragged){
    // Continúa desde donde está hasta salir totalmente por abajo.
    sheet.style.animation = 'none';
    sheet.style.transition = 'transform .22s cubic-bezier(.32,.72,.3,1), opacity .18s ease';
    sheet.style.transform = 'translate3d(0, 110vh, 0)';
    sheet.style.opacity = '0';
    modal.style.transition = 'opacity .20s ease';
    modal.style.opacity = '0';

    setTimeout(()=>{
      modal.classList.remove('open');
      modal.style.transition = '';
      modal.style.opacity = '';
      modal.style.backgroundColor = '';
      sheet.style.animation = '';
      sheet.style.transition = '';
      sheet.style.transform = '';
      sheet.style.opacity = '';
    }, 230);
  }else{
    modal.classList.remove('open');
    sheet.style.animation = '';
    sheet.style.transition = '';
    sheet.style.transform = '';
    sheet.style.opacity = '';
  }

  document.body.style.overflow = '';
  buzz(8);
}

function backdropClose(e){
  if(e.target.id === 'modal') closeInfo();
}


/* ============================================
   ARRASTRAR LA VENTANITA 1:1 CON EL DEDO
   ============================================ */
const dragHandle = document.querySelector('.modal-handle');
const dragSheet = document.getElementById('modalSheet');
const dragBackdrop = document.getElementById('modal');

function applySheetPosition(y){
  // Sin resistencia: la tarjeta se mueve exactamente los mismos px que el dedo.
  const dy = Math.max(0, y);

  if(sheetRAF) cancelAnimationFrame(sheetRAF);
  sheetRAF = requestAnimationFrame(()=>{
    dragSheet.style.transform = `translate3d(0, ${dy}px, 0)`;

    // El fondo solo se aclara conforme baja, pero no afecta el movimiento.
    const fade = Math.max(0, 1 - dy / Math.max(window.innerHeight * .72, 420));
    dragBackdrop.style.backgroundColor = `rgba(14,13,45,${0.42 * fade})`;
  });
}

function startSheetDrag(e){
  if(!modalOpen) return;

  e.preventDefault();
  e.stopPropagation();

  sheetDragging = true;
  sheetPointerId = e.pointerId;
  sheetStartY = e.clientY;
  sheetLastY = e.clientY;
  sheetLastTime = performance.now();
  sheetVelocity = 0;

  // IMPORTANTE: la animación de apertura deja de controlar transform.
  dragSheet.style.animation = 'none';
  dragSheet.style.transition = 'none';
  dragSheet.style.transform = 'translate3d(0,0,0)';
  dragSheet.classList.add('dragging');
  dragBackdrop.classList.add('dragging');

  try{ dragHandle.setPointerCapture(e.pointerId); }catch(_){}

  buzz(5);
}

function moveSheetDrag(e){
  if(!sheetDragging || e.pointerId !== sheetPointerId) return;

  e.preventDefault();
  e.stopPropagation();

  const now = performance.now();
  const dt = Math.max(1, now - sheetLastTime);
  sheetVelocity = (e.clientY - sheetLastY) / dt;
  sheetLastY = e.clientY;
  sheetLastTime = now;

  const dy = Math.max(0, e.clientY - sheetStartY);
  applySheetPosition(dy);
}

function finishSheetDrag(e){
  if(!sheetDragging) return;
  if(e && sheetPointerId !== null && e.pointerId !== sheetPointerId) return;

  if(e){
    e.preventDefault();
    e.stopPropagation();
  }

  const dy = Math.max(0, sheetLastY - sheetStartY);

  sheetDragging = false;
  dragSheet.classList.remove('dragging');
  dragBackdrop.classList.remove('dragging');

  try{
    if(sheetPointerId !== null) dragHandle.releasePointerCapture(sheetPointerId);
  }catch(_){}
  sheetPointerId = null;

  // Se cierra si ya bajaste aproximadamente 1/3 de la pantalla
  // o si hiciste un "flick" claro hacia abajo.
  const closeDistance = Math.min(window.innerHeight * .30, 230);
  const shouldClose = dy >= closeDistance || (dy > 55 && sheetVelocity > 0.85);

  if(shouldClose){
    closeInfo(true);
    return;
  }

  // Si no, vuelve desde EXACTAMENTE donde lo soltaste.
  dragSheet.style.animation = 'none';
  dragSheet.style.transition = 'transform .34s cubic-bezier(.22,1,.36,1)';
  dragSheet.style.transform = 'translate3d(0,0,0)';
  dragBackdrop.style.backgroundColor = '';

  setTimeout(()=>{
    if(modalOpen){
      dragSheet.style.transition = '';
      dragSheet.style.transform = '';
      // No restauramos modalIn: ya está abierta y quieta.
    }
  }, 350);
}

dragHandle.addEventListener('pointerdown', startSheetDrag);
dragHandle.addEventListener('pointermove', moveSheetDrag);
dragHandle.addEventListener('pointerup', finishSheetDrag);
dragHandle.addEventListener('pointercancel', finishSheetDrag);


document.addEventListener('touchstart', e=>{
  if(modalOpen || sheetDragging) return;
  const t = e.changedTouches[0];
  startX = t.screenX;
  startY = t.screenY;
},{passive:true});

document.addEventListener('touchend', e=>{
  if(modalOpen || sheetDragging) return;
  const t = e.changedTouches[0];
  const dx = t.screenX - startX;
  const dy = t.screenY - startY;

  if(Math.abs(dx) > 52 && Math.abs(dx) > Math.abs(dy)*1.25){
    dx < 0 ? nextSlide() : prevSlide();
  }
},{passive:true});

document.addEventListener('keydown', e=>{
  if(e.key === 'Escape' && modalOpen){
    closeInfo();
    return;
  }
  if(modalOpen) return;

  if(e.key === 'ArrowRight' || e.key === ' ') nextSlide();
  if(e.key === 'ArrowLeft') prevSlide();
});

function toggleBreathing(){
  breathing = !breathing;

  const circle = document.getElementById('breathCircle');
  const label = document.getElementById('breathLabel');
  const button = document.getElementById('pauseAction') || document.getElementById('breathButton');

  clearInterval(breathTimer);

  if(breathing){
    circle.classList.add('run');
    button.textContent = '■ Detener respiración';

    const steps = ['Inhala…','Mantén…','Exhala…','Descansa…'];
    let i = 0;
    label.textContent = steps[0];

    breathTimer = setInterval(()=>{
      i = (i+1)%steps.length;
      label.textContent = steps[i];
      if(navigator.vibrate) navigator.vibrate(8);
    },2000);
  }else{
    circle.classList.remove('run');
    label.textContent = 'Toca para comenzar';
    button.textContent = '▶ Iniciar respiración';
  }
}

const mythCardElement = document.getElementById('mythCard');
if(mythCardElement){
  mythCardElement.addEventListener('pointerdown',startMythDrag);
  mythCardElement.addEventListener('pointermove',moveMythDrag);
  mythCardElement.addEventListener('pointerup',finishMythDrag);
  mythCardElement.addEventListener('pointercancel',finishMythDrag);
  renderMythCard();
}

const glassCardElement = document.getElementById('glassCard');
if(glassCardElement){
  glassCardElement.addEventListener('click',hitGlass);
  resetGlass();
}

const careWheelElement = document.getElementById('careWheel');
if(careWheelElement){
  buildCareWheel();
  careWheelElement.addEventListener('keydown',event=>{
    if(event.key === 'Enter' || event.key === ' '){
      event.preventDefault();
      spinCare();
    }
  });
}

requestFit();
window.addEventListener('resize',requestFit);
window.addEventListener('orientationchange',()=>setTimeout(requestFit,80));
if(document.fonts && document.fonts.ready) document.fonts.ready.then(requestFit);
if('ResizeObserver' in window){
  const fitObserver = new ResizeObserver(requestFit);
  slides.forEach(slide=>{
    const card = [...slide.children].find(child=>child.classList?.contains('card'));
    if(card) fitObserver.observe(card);
  });
}

paintCurrentSlide(0,false);

// Astro procesa este bloque como módulo; los atributos inline del HTML
// necesitan encontrar estas funciones en el objeto global del navegador.
Object.assign(window, {
  nextSlide,
  prevSlide,
  goToSlide,
  openInfo,
  closeInfo,
  backdropClose,
  choosePause,
  startPause,
  anotherPause,
  chooseStereotype,
  spinCare
});
</script>
</body>
