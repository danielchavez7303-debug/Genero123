function renderMythCard(){
  const card = document.getElementById('mythCard');
  if(!card) return;
  const count = document.getElementById('mythCount');
  const phrase = document.getElementById('mythPhrase');
  const icon = document.getElementById('mythIcon');
  const progress = document.getElementById('mythProgress');
  const score = document.getElementById('mythScore');
  const stamp = document.getElementById('mythStamp');
  const realityStamp = document.getElementById('mythRealityStamp');

  card.classList.remove('is-myth','is-reality','finished');
  card.style.transform = '';
  card.style.opacity = '';
  stamp.style.opacity = '0';
  realityStamp.style.opacity = '0';
  realityStamp.textContent = 'REALIDAD';

  if(mythIndex >= mythDeck.length){
    card.classList.add('finished');
    icon.textContent = '🎉';
    phrase.textContent = '¡Terminaste el juego!';
    document.querySelector('.swipe-card-label').textContent = 'Tu resultado';
    document.querySelector('.swipe-direction').innerHTML = '<span>Identificaste</span><span>los estereotipos</span>';
    stamp.textContent = 'LISTO';
    stamp.className = 'swipe-stamp stamp-reality';
    stamp.style.opacity = '1';
    realityStamp.style.opacity = '0';
    count.textContent = `${mythDeck.length} / ${mythDeck.length}`;
    progress.style.width = '100%';
    score.textContent = `${mythScore} / ${mythDeck.length} identificados`;
    return;
  }

  const item = mythDeck[mythIndex];
  icon.textContent = item.icon;
  phrase.textContent = item.phrase;
  stamp.textContent = 'MITO';
  stamp.className = 'swipe-stamp stamp-myth';
  realityStamp.className = 'swipe-stamp stamp-reality';
  count.textContent = `${mythIndex+1} / ${mythDeck.length}`;
  progress.style.width = `${(mythIndex/mythDeck.length)*100}%`;
  score.textContent = `Respuestas correctas: ${mythScore}`;
}

function updateMythDrag(dx){
  const card = document.getElementById('mythCard');
  if(!card) return;
  const rotation = Math.max(-13,Math.min(13,dx/12));
  const strength = Math.min(Math.abs(dx)/115,1);
  card.style.transform = `translate3d(${dx}px,${Math.abs(dx)*-.025}px,0) rotate(${rotation}deg)`;
  card.classList.toggle('is-myth',dx < -8);
  card.classList.toggle('is-reality',dx > 8);
  card.style.setProperty('--stamp-strength',strength);
  card.querySelector('.stamp-myth').style.opacity = dx < 0 ? strength : 0;
  card.querySelector('.stamp-reality').style.opacity = dx > 0 ? strength : 0;
}

function startMythDrag(e){
  if(mythBusy || mythIndex >= mythDeck.length) return;
  mythDragging = true;
  mythStartX = e.clientX;
  mythPointerId = e.pointerId;
  const card = document.getElementById('mythCard');
  card.classList.add('dragging');
  try{card.setPointerCapture(e.pointerId)}catch(_){ }
  e.preventDefault();
}

function moveMythDrag(e){
  if(!mythDragging || e.pointerId !== mythPointerId) return;
  updateMythDrag(e.clientX-mythStartX);
  e.preventDefault();
}

function finishMythDrag(e){
  if(!mythDragging) return;
  const card = document.getElementById('mythCard');
  const dx = e ? e.clientX-mythStartX : 0;
  mythDragging = false;
  mythPointerId = null;
  card.classList.remove('dragging');
  try{card.releasePointerCapture(e.pointerId)}catch(_){ }

  if(Math.abs(dx) < 95){
    card.style.transform = '';
    card.classList.remove('is-myth','is-reality');
    card.querySelector('.stamp-myth').style.opacity = 0;
    card.querySelector('.stamp-reality').style.opacity = 0;
    return;
  }
  answerMyth(dx < 0 ? 'myth' : 'reality');
}

function answerMyth(choice){
  if(mythBusy || mythIndex >= mythDeck.length) return;
  mythBusy = true;
  const item = mythDeck[mythIndex];
  const correct = choice === item.answer;
  if(correct) mythScore++;
  const card = document.getElementById('mythCard');
  const feedback = document.getElementById('mythFeedback');
  const stamp = card.querySelector(choice === 'myth' ? '.stamp-myth' : '.stamp-reality');
  stamp.style.opacity = 1;
  stamp.textContent = choice === 'myth' ? 'MITO' : 'REALIDAD';
  card.classList.add(choice === 'myth' ? 'is-myth' : 'is-reality');
  card.style.transform = `translate3d(${choice === 'myth' ? '-125vw':'125vw'},${choice === 'myth' ? '-8px':'8px'},0) rotate(${choice === 'myth' ? '-22deg':'22deg'})`;
  const label = correct ? '¡Bien identificado!' : 'Casi: revisa la explicación';
  feedback.innerHTML = `<strong>${correct ? '✓' : '→'} ${label}</strong><br>${item.explanation}`;
  feedback.classList.add('show');
  buzz(correct ? 12 : 6);

  setTimeout(()=>{
    mythIndex++;
    feedback.classList.remove('show');
    renderMythCard();
    mythBusy = false;
  },1250);
}

