/* =========================================================
   AJUSTE RESPONSIVE FINAL
   Una sola base fluida para teléfonos, tablets, laptops,
   monitores grandes y pantallas en horizontal.
   ========================================================= */
html,body{
  width:100%;
  height:100%;
  overflow:hidden;
}
.app{
  width:100%;
  height:100dvh;
  min-height:0;
  padding:0;
}
.deck{
  width:min(100%,1440px);
  height:100dvh;
  margin:0 auto;
}
.slide{
  width:100%;
  height:100dvh;
  min-height:0;
  padding:
    max(18px,calc(env(safe-area-inset-top) + clamp(22px,6vh,70px)))
    clamp(12px,4vw,64px)
    calc(env(safe-area-inset-bottom) + clamp(78px,10vh,112px));
  overflow-y:auto;
  overflow-x:hidden;
  scrollbar-width:none;
}
.slide::-webkit-scrollbar{display:none}
.card{
  width:100%;
  max-width:min(1120px,100%);
